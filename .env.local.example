NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
RESEND_API_KEY=
RESEND_FROM_EMAIL=
ANTHROPIC_API_KEY=
BRAND_AGENCY_ID=
REVIEWER_MODEL=claude-sonnet-4-6
ADMIN_EMAILS=brook@yourpolicyplace.com,wesoverstreet@gmail.com

# Public origin of the deployed portal. PORTAL_URL builds every absolute link
# in emails/API responses; SITE_URL is baked into the verify-QR stamped onto
# each cert PDF (falls back to localhost if unset — set BOTH in prod).
NEXT_PUBLIC_PORTAL_URL=https://coi-portal.vercel.app
NEXT_PUBLIC_SITE_URL=https://coi-portal.vercel.app

# Vercel Cron auth. Vercel sends `Authorization: Bearer ${CRON_SECRET}` on
# scheduled invocations. In production the cron routes return 503 when this is
# unset (fail closed). Generate with `openssl rand -hex 32`.
CRON_SECRET=

# Bearer key for the agent-native API (POST /api/v1/certificates). Endpoint
# returns 503 when unset. Generate with `openssl rand -hex 32`.
AGENT_API_KEY=

# Per-client cert issuance rate limits (defaults: 20/hour, 200/day).
CERT_HOURLY_LIMIT=20
CERT_DAILY_LIMIT=200

# Optional audit BCC/CC on every sent certificate. Cert Holders see this address
# in the email envelope, so use an inbox that's safe to expose (or leave unset).
COI_CC_AUDIT_EMAIL=

# HMAC secret for one-tap admin approval tokens embedded in queue-notification
# emails. Must be 32+ hex chars. Generate with `openssl rand -hex 32`.
# Rotating this secret invalidates every outstanding approval link.
APPROVAL_TOKEN_SECRET=

# Resend delivery webhook (POST /api/webhooks/resend) — updates the outbound
# email ledger (delivered / bounced / opened). Create the webhook in Resend's
# dashboard pointing at that route and paste the signing secret (whsec_...).
# In production the route returns 503 when this is unset (fail closed).
RESEND_WEBHOOK_SECRET=

# Inbound email → auto-COI (POST /api/inbound/coi-request)
# Shared secret sent from the inbound provider (Resend Inbound / Postmark / SES) as
# `x-inbound-secret` (or `x-webhook-secret`). Generate with `openssl rand -hex 32`.
RESEND_INBOUND_WEBHOOK_SECRET=
# Public address clients email their requests to. Configure this in Resend Inbound.
INBOUND_COI_ADDRESS=coi@inbound.policyplace.com
# Override the Claude model used by the inbound classifier + parser (optional).
INBOUND_LLM_MODEL=claude-sonnet-4-6

# Conversational chat agent (client-facing chat widget + SMS inbound).
# Defaults to claude-sonnet-4-6 if unset.
CHAT_MODEL=claude-sonnet-4-6

# Twilio SMS channel (optional). Configure the webhook in Twilio's console:
# Phone Numbers -> your number -> Messaging -> A MESSAGE COMES IN -> set to
# https://coi-portal.vercel.app/api/sms/inbound  (POST, raw form).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
